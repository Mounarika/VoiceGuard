# VoxDetect Frontend — Environment Variables
# Copy to .env and update for your environment. Never commit .env.

# Leave empty in local development to use the Vite proxy to localhost:8000.
# For a separately hosted backend, set its public origin (no trailing slash).
VITE_API_URL=

# Optional WebSocket base URL (ws:// or wss://). When empty, the app derives
# ws(s):// from VITE_API_URL or uses the current origin (Vite proxies /v1).
VITE_WS_URL=
